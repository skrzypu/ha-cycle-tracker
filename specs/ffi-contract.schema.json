{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cycle Tracker FFI Contract",
  "description": "Shared JSON schema for FFI boundary between KMP (Kotlin) and Python (Home Assistant)",
  "type": "object",
  "definitions": {
    "FfiLocalDate": {
      "type": "object",
      "title": "LocalDate",
      "description": "Date representation for FFI boundary",
      "required": ["year", "month", "day"],
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      },
      "additionalProperties": false
    },
    "FfiPeriodEntry": {
      "type": "object",
      "title": "PeriodEntry",
      "description": "Single menstrual period entry",
      "required": ["startDate", "endDate"],
      "properties": {
        "startDate": { "$ref": "#/definitions/FfiLocalDate" },
        "endDate": { "$ref": "#/definitions/FfiLocalDate" },
        "flowIntensity": { "type": "string", "enum": ["LIGHT", "MEDIUM", "HEAVY", "SPOTTING"], "default": "MEDIUM" },
        "notes": { "type": ["string", "null"], "default": null }
      },
      "additionalProperties": false
    },
    "FfiCreateConfig": {
      "type": "object",
      "title": "CreateConfig",
      "description": "Configuration for creating a new cycle tracker instance",
      "properties": {
        "initialPeriods": {
          "type": "array",
          "items": { "$ref": "#/definitions/FfiPeriodEntry" },
          "default": []
        },
        "averageCycleLength": { "type": "integer", "minimum": 20, "maximum": 45, "default": 28 },
        "averagePeriodLength": { "type": "integer", "minimum": 2, "maximum": 10, "default": 5 }
      },
      "additionalProperties": false
    },
    "FfiCyclePhase": {
      "type": "object",
      "title": "CyclePhase",
      "description": "Current menstrual cycle phase",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "enum": ["MENSTRUAL", "FOLLICULAR", "OVULATION", "LUTEAL"] }
      },
      "additionalProperties": false
    },
    "FfiPredictionResult": {
      "type": "object",
      "title": "PredictionResult",
      "description": "Prediction output from the algorithm",
      "required": ["nextPeriodStart", "cyclePhase", "daysUntilNextPeriod", "confidence"],
      "properties": {
        "nextPeriodStart": { "$ref": "#/definitions/FfiLocalDate" },
        "cyclePhase": { "$ref": "#/definitions/FfiCyclePhase" },
        "daysUntilNextPeriod": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "FfiStatistics": {
      "type": "object",
      "title": "Statistics",
      "description": "Statistical summary of tracked cycles",
      "required": ["averageCycleLength", "averagePeriodLength", "cycleLengthStdDev", "periodLengthStdDev", "totalCyclesTracked", "shortestCycle", "longestCycle"],
      "properties": {
        "averageCycleLength": { "type": "number", "minimum": 0 },
        "averagePeriodLength": { "type": "number", "minimum": 0 },
        "cycleLengthStdDev": { "type": "number", "minimum": 0 },
        "periodLengthStdDev": { "type": "number", "minimum": 0 },
        "totalCyclesTracked": { "type": "integer", "minimum": 0 },
        "shortestCycle": { "type": "integer", "minimum": 0 },
        "longestCycle": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/FfiCreateConfig" },
    { "$ref": "#/definitions/FfiPeriodEntry" },
    { "$ref": "#/definitions/FfiLocalDate" },
    { "$ref": "#/definitions/FfiPredictionResult" },
    { "$ref": "#/definitions/FfiCyclePhase" },
    { "$ref": "#/definitions/FfiStatistics" }
  ]
}