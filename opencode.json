{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "default", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "**/*.py", "effect": "allow" },
    { "action": "read", "resource": "**/*.yaml", "effect": "allow" },
    { "action": "read", "resource": "**/*.yml", "effect": "allow" },
    { "action": "read", "resource": "**/*.json", "effect": "allow" },
    { "action": "read", "resource": "**/*.md", "effect": "allow" },
    { "action": "read", "resource": "**/*.toml", "effect": "allow" },
    { "action": "read", "resource": ".github/**", "effect": "allow" },
    { "action": "read", "resource": "custom_components/**", "effect": "allow" },
    { "action": "read", "resource": "specs/**", "effect": "allow" },
    { "action": "read", "resource": ".pre-commit-config.yaml", "effect": "allow" },
    { "action": "read", "resource": "pyproject.toml", "effect": "allow" },
    { "action": "read", "resource": ".gitignore", "effect": "allow" },
    { "action": "read", "resource": "pytest.ini", "effect": "allow" },
    { "action": "edit", "resource": "**/*.py", "effect": "allow" },
    { "action": "edit", "resource": "**/*.yaml", "effect": "allow" },
    { "action": "edit", "resource": "**/*.yml", "effect": "allow" },
    { "action": "edit", "resource": "**/*.json", "effect": "allow" },
    { "action": "edit", "resource": "**/*.md", "effect": "allow" },
    { "action": "edit", "resource": "**/*.toml", "effect": "allow" },
    { "action": "edit", "resource": ".github/**", "effect": "allow" },
    { "action": "edit", "resource": "custom_components/**", "effect": "allow" },
    { "action": "edit", "resource": "specs/**", "effect": "allow" },
    { "action": "edit", "resource": ".pre-commit-config.yaml", "effect": "allow" },
    { "action": "edit", "resource": "pyproject.toml", "effect": "allow" },
    { "action": "edit", "resource": ".gitignore", "effect": "allow" },
    { "action": "edit", "resource": "pytest.ini", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free#high",
      "description": "Main orchestrator for ha-cycle-tracker"
    }
  }
}
